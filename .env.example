# SwiftDelivery V3 — environment template
#
# This is a single-file vanilla JS app — there is no build step and no
# runtime env loader. The values below are baked into index.html as
# `window.SWD_*` globals. Use this file as a checklist when bootstrapping
# a new clone: paste each value into the matching <script> block in
# index.html.

# Google Maps JavaScript API key (Maps + Places enabled).
# Set HTTP referrer restrictions to your Vercel domain in Google Cloud
# Console — without that, anyone can read this from page source and
# rack up your billing.
SWD_MAPS_KEY=YOUR_GOOGLE_MAPS_KEY

# Firebase web config (from Firebase Console → Project Settings → SDK setup).
# These values are NOT secrets in Firebase's threat model — they identify
# the project. Real protection comes from Firestore Security Rules
# (see firestore.rules.example).
SWD_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
SWD_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
SWD_FIREBASE_PROJECT_ID=YOUR_PROJECT
SWD_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.firebasestorage.app
SWD_FIREBASE_MESSAGING_SENDER_ID=000000000000
SWD_FIREBASE_APP_ID=1:000000000000:web:abcdef

# Paystack public test key (V3). Public keys are safe in client code.
# Get one free at dashboard.paystack.com → Settings → API Keys.
# Use pk_test_... while developing; swap to pk_live_... only after
# tightening Firestore rules and Paystack webhook verification.
SWD_PAYSTACK_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
