// SwiftDelivery — example Firestore Security Rules
//
// The web Firebase API key is public, so the only thing protecting your
// Firestore data is these rules. Paste into the Firebase Console →
// Firestore Database → Rules tab.
//
// This template is *permissive* (matches the demo's lack of Firebase Auth)
// but at least restricts collection scope. Tighten as you adopt Auth.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // SwiftDelivery state lives in a single "swd" collection with a
    // small, fixed set of document IDs. Anything outside this is denied.
    match /swd/{docId} {
      allow read:  if docId in [
        'users','orders','riders','misc','transactions','reviews'
      ];
      allow write: if docId in [
        'users','orders','riders','misc','transactions','reviews'
      ];
    }

    // Live rider GPS doc (single doc with rider_<id> sub-keys)
    match /locations/{docId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
